# Application database on Common Postgres (role storage, database db_storage)
DATABASE_URL=postgresql+asyncpg://storage:changeme@postgres:5432/db_storage

# Common Redis
REDIS_URL=redis://redis:6379

# Single MinIO bucket on Common (do not create or touch mlflow)
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_USE_SSL=false
S3_BUCKET=storage
S3_PATH_STYLE=true

# Capacity / health of the single storage bucket
DISK_STRATEGY=most_free_space
DISK_SPACE_CACHE_TTL=30
MIN_FREE_SPACE_MB=500

# Private vault cookie (identity is gateway headers, not this cookie)
AUTH_COOKIE_NAME=auth_session
PRIVATE_SESSION_TTL_HOURS=4

# User-Service on user_network (network trust, no JWT)
USER_SERVICE_URL=http://user_service:8000
USER_SERVICE_TIMEOUT_MS=2000
USER_SERVICE_CACHE_TTL_SECONDS=60

# Compose network Auth-Service uses so the gateway can resolve app:8000
# From Auth-Service/deploy → deploy_auth; from repo root → auth-service_auth
AUTH_DOCKER_NETWORK=deploy_auth

# Business logic
PHOTO_BATCH_SIZE=30
THUMBNAIL_MAX_PX=400
DEFAULT_USER_QUOTA_MB=100
ARCHIVE_DAYS_THRESHOLD=180

# Logging
LOG_LEVEL=INFO
LOG_FILE_ENABLED=false
LOG_FILE_PATH=/var/log/homecloud/app.log
LOG_FILE_ROTATION=100 MB
LOG_FILE_RETENTION=30 days

# Built SPA directory inside the app image (ignored when missing, e.g. local backend mount)
SPA_STATIC_DIR=/opt/spa

# Frontend (local Vite only, not used by the backend container)
# VITE_API_BASE_URL=http://localhost:8000
# API_PROXY_TARGET=http://localhost:8000
