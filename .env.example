# PostgreSQL (docker-compose / k8s db service)
POSTGRES_DB=cloud_db
POSTGRES_USER=postgres_admin
POSTGRES_PASSWORD=changeme

# Application database
DATABASE_URL=postgresql+asyncpg://postgres_admin:changeme@db:5432/cloud_db

# First administrator (created by init_db.py)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# Redis
REDIS_URL=redis://redis:6379

# Storage
STORAGE_BACKEND=s3
STORAGE_DISKS=disk1
STORAGE_ROOT=/storage
DISK_STRATEGY=most_free_space
DISK_SPACE_CACHE_TTL=30
MIN_FREE_SPACE_MB=500

# MinIO / S3 (used when STORAGE_BACKEND=s3)
# Keep STORAGE_BACKEND=fs until the S3 adapter and migration are ready.
# Buckets map 1:1 to STORAGE_DISKS: bucket = {S3_BUCKET_PREFIX}{disk_id}
# e.g. S3_BUCKET_PREFIX=hc- and STORAGE_DISKS=disk1,disk2 → buckets hc-disk1, hc-disk2
# Leave S3_BUCKET_PREFIX empty to use disk ids as bucket names directly
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=ru
S3_USE_SSL=false
S3_BUCKET_PREFIX=web_storage
S3_PATH_STYLE=true

# Authentication (local JWT/Google — kept until Auth-Service stories retire them)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://filenkov.store:8000/api/auth/google/callback
FRONTEND_URL=http://filenkov.store
JWT_SECRET=change-me-to-a-random-secret
SESSION_TTL_SECONDS=86400
PRIVATE_SESSION_TTL_HOURS=4

# Auth-Service gRPC (US-AUTHZ-03 / US-AUTHZ-10)
# AUTH_GRPC_ADDR is the Docker-internal dial target (join AUTH_DOCKER_NETWORK).
# AUTH_CALLER_HOST is the whitelist identity after scheme/port/path strip — not a hostname to dial.
AUTH_GRPC_ADDR=api:9090
AUTH_CALLER_HOST=storage.filenkov.store
# Compose project of Auth-Service (`deploy/docker-compose.yml`) + `_auth`.
# From Auth-Service/deploy → deploy_auth; from repo root → auth-service_auth.
AUTH_DOCKER_NETWORK=deploy_auth
AUTH_COOKIE_NAME=auth_session
AUTH_GRPC_TIMEOUT_MS=2000
AUTH_LOGIN_URL=https://filenkov.store/oauth/google?return_to=https://storage.filenkov.store/
AUTH_LOGOUT_URL=http://api:8080

# Business logic
PHOTO_BATCH_SIZE=30
THUMBNAIL_MAX_PX=400
DEFAULT_USER_QUOTA_MB=100
# Deprecated alias for DEFAULT_USER_QUOTA_MB (still accepted by the backend)
# STRANGER_QUOTA_MB=100
ARCHIVE_DAYS_THRESHOLD=180

# Logging (structured JSON via python-json-logger)
LOG_LEVEL=INFO
LOG_FILE_ENABLED=false
LOG_FILE_PATH=/var/log/homecloud/app.log
LOG_FILE_ROTATION=100 MB
LOG_FILE_RETENTION=30 days

# Frontend (local dev only, not used by backend container)
# VITE_API_BASE_URL=http://localhost:8000
# Hub Google OAuth (US-AUTHZ-09). Default in SPA matches AUTH_LOGIN_URL.
# VITE_AUTH_LOGIN_URL=https://filenkov.store/oauth/google?return_to=https://storage.filenkov.store/
# API_PROXY_TARGET=http://localhost:8000
