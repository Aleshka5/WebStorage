# Reverse proxy: all HTTP traffic gets redirected to HTTPS
https://filenkov.store {
    # --- Reverse proxy ---
    # /api/*, /docs, /openapi.json, /redoc -> backend (FastAPI)
    @api path /api/* /docs /openapi.json /redoc
    reverse_proxy @api app:8000

    # /app/* -> frontend (Vite / static build)
    @app path /app/*
    reverse_proxy @app frontend:5173

    # Everything else -> lllama server (host:1234)
    reverse_proxy 192.168.1.102:8080

    # --- TLS ---
    # Automatic HTTPS: Caddy requests a Let's Encrypt cert for filenkov.store
    # because ports 80 and 443 are forwarded to your machine.
    tls {
        protocols tls1.3
    }

    # --- Headers ---
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }

    # --- Logging ---
    log {
        output file /var/log/caddy/access.log {
            roll_size 50mb
            roll_keep 5
        }
        format json
    }

}

# Plain HTTP -> HTTPS redirect (for browsers that connect directly to http://)
http://filenkov.store {
    redir https://filenkov.store{uri}
}


